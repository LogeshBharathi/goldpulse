      "id": "c003a3f5-9660-5bd7-9d0f-5eea1159e7ba",
      "name": "Fetch latest price",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1560,
        300
      ],
      "credentials": {
        "httpHeaderAuth": {
