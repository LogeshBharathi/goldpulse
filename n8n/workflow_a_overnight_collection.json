        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({workflow: 'overnight_collect', level: 'ERROR', event: 'fetch_failed', message: 'fetch failed: ' + ($json.error?.message || JSON.stringify($json.error || $json)), payload: $json}) }}"
      },
      "id": "fd39d7a2-bf82-5464-9c96-c63d76af3271",
      "name": "Log fetch failure",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        2860,
        300
      ],
      "credentials": {
