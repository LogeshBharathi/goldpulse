          "id": "REPLACE_ME",
          "name": "GoldPulse API"
        }
      },
      "retryOnFail": true,
      "maxTries": 2,
      "waitBetweenTries": 3000
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://api:8000/api/v1/logs",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {
          "timeout": 10000
        },
        "sendBody": true,
        "contentType": "json",
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({workflow: 'overnight_collect', level: 'WARNING', event: 'validation_failed', message: 'invalid/stale data: ' + $json.problems.join('; '), payload: $json}) }}"
      },
      "id": "6570cbba-397d-53f0-9ad4-7b51acd5b5e4",
      "name": "Log validation failure",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        3120,
        300
      ],
      "credentials": {
        "httpHeaderAuth": {
          "id": "REPLACE_ME",
          "name": "GoldPulse API"
        }
      },
      "retryOnFail": true,
      "maxTries": 2,
      "waitBetweenTries": 3000
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://api:8000/api/v1/logs",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {
          "timeout": 10000
        },
        "sendBody": true,
        "contentType": "json",
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({workflow: 'overnight_collect', level: 'ERROR', event: 'save_failed', message: 'snapshot rejected/failed: ' + ($json.error?.message || JSON.stringify($json.error || $json)), payload: $json}) }}"
      },
      "id": "307e3fb3-2601-5acf-9823-2dbab0c7fa00",
      "name": "Log save failure",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        3380,
        300
      ],
      "credentials": {
        "httpHeaderAuth": {
          "id": "REPLACE_ME",
          "name": "GoldPulse API"
        }
      },
      "retryOnFail": true,
      "maxTries": 2,
      "waitBetweenTries": 3000
    }
  ],
