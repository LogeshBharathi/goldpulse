# ---- Copy to .env and fill in. NEVER commit .env. All values below are PLACEHOLDERS. ----

# PostgreSQL (docker-compose uses these)
POSTGRES_USER=goldpulse
POSTGRES_PASSWORD=change_me
POSTGRES_DB=goldpulse
DATABASE_URL=postgresql+psycopg2://goldpulse:change_me@db:5432/goldpulse

# Shared secret: n8n -> API (create an n8n "Header Auth" credential named "GoldPulse API": header X-API-Key)
GOLDPULSE_API_KEY=generate_a_long_random_string

# Model artifact directory produced by scripts/train.py (set ACTIVE_MODEL_PATH to the printed path)
MODEL_DIR=models
ACTIVE_MODEL_PATH=models/REPLACE_WITH_VERSION_DIR
HOLIDAY_DIR=data/holidays

# ---- Market data providers (licensed! see docs/DATA_SOURCES.md) ----
# XAU/USD and USD/INR via Twelve Data preset. Check plan terms for commercial use / redistribution.
TWELVEDATA_API_KEY=

# Indicative public feeds used only when no licensed vendor answers:
# Yahoo Finance GC=F (COMEX, delayed), xaus.com spot (XAU/USD and USD/INR), Moneycontrol MCX GOLD futures.
# Not an exchange license. The forecast records that limitation.
PUBLIC_MARKET_DATA=false

# COMEX gold futures: any licensed REST vendor. Map the JSON fields with the *_PATH variables (dotted paths).
COMEX_API_URL=
COMEX_API_KEY=
COMEX_API_PARAMS={}
COMEX_PRICE_PATH=price
COMEX_TS_EPOCH_PATH=
COMEX_TS_PATH=
COMEX_TS_TZ=UTC
COMEX_DELAYED=true
COMEX_DELAY_MINUTES=10

# MCX gold futures (INR/10g), same mechanism. Use the continuous/rollover-adjusted contract your vendor documents.
MCX_API_URL=
MCX_API_KEY=
MCX_API_PARAMS={}
MCX_PRICE_PATH=price
MCX_TS_EPOCH_PATH=
MCX_TS_PATH=
MCX_TS_TZ=Asia/Kolkata
MCX_DELAYED=true
MCX_DELAY_MINUTES=15

# ---- Forecast behaviour ----
NEUTRAL_THRESHOLD_PCT=0.10
INTERVAL_LEVEL=0.80
MIN_TRAIN_ROWS=250
MAX_AGE_COMEX_H=3
MAX_AGE_XAUUSD_H=3
MAX_AGE_USDINR_H=6
MAX_AGE_MCX_H=36

# ---- Retail price assumptions (PLACEHOLDERS: verify the current duty/GST and calibrate premium/margin) ----
IMPORT_DUTY_PCT=6.0
GST_PCT=3.0
DOMESTIC_PREMIUM_PCT=0.0
RETAIL_MARGIN_PCT=0.0
MAKING_CHARGES_PCT=0.0

# ---- Telegram (also set in the n8n Telegram credential) ----
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ---- n8n ----
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=change_me
N8N_ENCRYPTION_KEY=generate_a_long_random_string
